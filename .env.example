# ── App ─────────────────────────────────────────────────────────────────────
# Canonical site URL — used for metadata (Open Graph / Twitter absolute URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Copy this file to `.env` and fill in real values from your Supabase project
# (Project Settings → Database and Project Settings → API).
# Full walkthrough: docs/supabase-setup.md

# App runtime connection — Supabase pooler (transaction mode), port 6543.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Migrations and Prisma CLI — direct connection, port 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL — safe for the browser (NEXT_PUBLIC_ prefixed).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Anon key — safe for the browser; access is constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Service role key — SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ and never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
